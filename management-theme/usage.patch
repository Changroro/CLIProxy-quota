diff --git a/src/features/usage/UsagePage.tsx b/src/features/usage/UsagePage.tsx
new file mode 100644
index 0000000..9b486a3
--- /dev/null
+++ b/src/features/usage/UsagePage.tsx
@@ -0,0 +1,116 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Button } from '@/components/ui/Button';
+import { useAuthStore, useThemeStore } from '@/stores';
+import styles from './UsagePage.module.scss';
+
+const COLLECTOR = 'http://127.0.0.1:8318';
+
+export function UsagePage() {
+  const { t, i18n } = useTranslation();
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const managementKey = useAuthStore((state) => state.managementKey);
+  const resolvedTheme = useThemeStore((state) => state.resolvedTheme);
+  const frame = useRef<HTMLIFrameElement>(null);
+  const [session, setSession] = useState<{ connection: string; token: string } | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [attempt, setAttempt] = useState(0);
+  const connection = JSON.stringify([apiBase, managementKey]);
+  const token = session?.connection === connection ? session.token : null;
+
+  useEffect(() => {
+    const controller = new AbortController();
+    const timeout = window.setTimeout(() => controller.abort(), 10000);
+    let current = true;
+    setFailed(false);
+    const connect = async () => {
+      try {
+        const response = await fetch(`${COLLECTOR}/api/management-session`, {
+          method: 'POST',
+          headers: {
+            'Content-Type': 'application/json',
+            'X-Quota-Client': '1',
+            Authorization: `Bearer ${managementKey}`,
+          },
+          body: JSON.stringify({ proxy_url: apiBase.replace(/\/$/, '') }),
+          signal: controller.signal,
+          credentials: 'omit',
+          redirect: 'error',
+        });
+        if (!response.ok) throw new Error('Collector connection rejected');
+        const payload: unknown = await response.json();
+        if (
+          !payload ||
+          typeof payload !== 'object' ||
+          !('token' in payload) ||
+          typeof payload.token !== 'string' ||
+          !payload.token
+        ) {
+          throw new Error('Invalid collector session');
+        }
+        if (current) setSession({ connection, token: payload.token });
+      } catch {
+        if (current) setFailed(true);
+      } finally {
+        window.clearTimeout(timeout);
+      }
+    };
+    void connect();
+    return () => {
+      current = false;
+      window.clearTimeout(timeout);
+      controller.abort();
+    };
+  }, [apiBase, managementKey, connection, attempt]);
+
+  const appearance = useCallback(() => {
+    frame.current?.contentWindow?.postMessage(
+      {
+        type: 'quota-appearance',
+        theme: resolvedTheme,
+        language: i18n.language.startsWith('ko') ? 'ko' : 'en',
+      },
+      COLLECTOR
+    );
+  }, [resolvedTheme, i18n.language]);
+
+  useEffect(() => {
+    const ready = (event: MessageEvent) => {
+      if (
+        event.origin === COLLECTOR &&
+        event.source === frame.current?.contentWindow &&
+        event.data?.type === 'quota-ready'
+      )
+        appearance();
+    };
+    window.addEventListener('message', ready);
+    appearance();
+    return () => window.removeEventListener('message', ready);
+  }, [appearance, token]);
+
+  if (!token || failed) {
+    return (
+      <section className={styles.state} aria-live="polite">
+        <h1>{t('usage_companion.title')}</h1>
+        <p>{t(failed ? 'usage_companion.unavailable' : 'usage_companion.connecting')}</p>
+        {failed && (
+          <>
+            <code>cli-proxy-quota dashboard --no-open</code>
+            <Button onClick={() => setAttempt((value) => value + 1)}>{t('common.refresh')}</Button>
+          </>
+        )}
+      </section>
+    );
+  }
+
+  return (
+    <iframe
+      ref={frame}
+      className={styles.frame}
+      title={t('usage_companion.title')}
+      src={`${COLLECTOR}/?embedded=1#token=${encodeURIComponent(token)}`}
+      referrerPolicy="origin"
+      onLoad={appearance}
+    />
+  );
+}
