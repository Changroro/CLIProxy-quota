+/// cxstatusline: seconds since the Unix epoch -> RFC 3339 UTC.
+fn cxstatusline_iso8601(seconds: i64) -> Option<String> {
+    chrono::DateTime::<chrono::Utc>::from_timestamp(seconds, 0)
+        .map(|dt| dt.to_rfc3339_opts(chrono::SecondsFormat::Secs, /*use_z*/ true))
+}
+
+/// cxstatusline: run the external renderer once. `None` on spawn failure, non-zero exit, timeout,
+/// malformed, blank, or oversized stdout - the caller keeps the previous complete block.
+async fn cxstatusline_run(argv: &[String], payload: String) -> Option<Vec<Line<'static>>> {
+    use tokio::io::AsyncWriteExt;
+    let (program, args) = argv.split_first()?;
+    let mut child = tokio::process::Command::new(program)
+        .args(args)
+        .stdin(std::process::Stdio::piped())
+        .stdout(std::process::Stdio::piped())
+        .stderr(std::process::Stdio::null())
+        .kill_on_drop(true)
+        .spawn()
+        .ok()?;
+    let mut stdin = child.stdin.take()?;
+    stdin.write_all(payload.as_bytes()).await.ok()?;
+    // Drop closes the pipe so the renderer sees EOF.
+    drop(stdin);
+    let output = tokio::time::timeout(CXSTATUSLINE_TIMEOUT, child.wait_with_output())
+        .await
+        .ok()?
+        .ok()?;
+    if !output.status.success() {
+        return None;
+    }
+    cxstatusline_parse_output(&String::from_utf8_lossy(&output.stdout))
+}
+
+/// Parse all renderer rows before exposing them to the shared block; a malformed block never
+/// replaces the last complete render.
+pub(super) fn cxstatusline_parse_output(text: &str) -> Option<Vec<Line<'static>>> {
+    let text = text.strip_suffix('\n').unwrap_or(text);
+    let rows: Vec<_> = text.split('\n').collect();
+    ((1..=3).contains(&rows.len()) && rows.iter().all(|line| !line.trim().is_empty())).then(|| {
+        rows.into_iter()
+            .map(codex_ansi_escape::ansi_escape_line)
+            .collect()
+    })
+}
