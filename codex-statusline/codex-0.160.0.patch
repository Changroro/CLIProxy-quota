+#[tokio::test]
+async fn cxstatusline_rate_limit_refresh_updates_snapshots_without_status_card() -> Result<()> {
+    let (mut app, mut app_event_rx, _op_rx) = make_test_app_with_channels().await;
+    set_chatgpt_auth(&mut app.chat_widget);
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    let mut app_server = Box::pin(crate::start_embedded_app_server_for_picker(
+        app.chat_widget.config_ref(),
+    ))
+    .await?;
+    let (request_id, hard_stop_generation) = app
+        .rate_limit_refresh_state
+        .start(
+            RateLimitRefreshOrigin::CxStatusLine,
+            &mut app.rate_limit_hard_stop_generation,
+        )
+        .expect("cxstatusline refresh starts");
+
+    app.handle_event(
+        &mut tui,
+        &mut app_server,
+        AppEvent::RateLimitsLoaded {
+            request_id,
+            origin: RateLimitRefreshOrigin::CxStatusLine,
+            hard_stop_generation,
+            result: Ok(account_rate_limits_response(rate_limit_snapshot(
+                /*used_percent*/ 89, /*rate_limit_reached_type*/ None,
+                /*spend_control_reached*/ None,
+            ))),
+        },
+    )
+    .await?;
+
+    assert!(
+        !std::iter::from_fn(|| app_event_rx.try_recv().ok())
+            .any(|event| matches!(event, AppEvent::InsertHistoryCell(_))),
+        "cxstatusline refresh must not create a status card"
+    );
+    let status = render_status_output(&mut app, &mut app_event_rx);
+    assert!(
+        status.contains("11% left"),
+        "expected cxstatusline refresh to update cached limits, got: {status}"
+    );
+
+    app_server.shutdown().await?;
+    Ok(())
+}
