+#[tokio::test]
+async fn cxstatusline_git_values_change_after_a_turn() {
+    let repo = tempfile::tempdir().expect("temp repo");
+    let git = |args: &[&str]| {
+        let output = std::process::Command::new("git")
+            .args(args)
+            .current_dir(repo.path())
+            .output()
+            .expect("git runs");
+        assert!(
+            output.status.success(),
+            "{}",
+            String::from_utf8_lossy(&output.stderr)
+        );
+    };
+    git(&["init", "-b", "main"]);
+    git(&[
+        "-c",
+        "user.name=Test",
+        "-c",
+        "user.email=test@example.com",
+        "commit",
+        "--allow-empty",
+        "-m",
+        "base",
+    ]);
+    let (mut chat, mut rx, _ops) = make_chatwidget_manual(/*model_override*/ None).await;
+    chat.config.cwd = AbsolutePathBuf::try_from(repo.path().to_path_buf()).expect("absolute cwd");
+    chat.current_cwd = Some(repo.path().to_path_buf());
+    chat.local_settings.tui.status_line = Some(vec![]);
+    chat.local_settings.tui.terminal_title = Some(vec![]);
+    chat.cxstatusline_command = Some(vec!["unused-renderer".into()]);
+    // Exercise collection without launching a renderer during completion callbacks.
+    chat.cxstatusline_pending.store(true, Ordering::Release);
+    chat.workspace_command_runner = Some(std::sync::Arc::new(CxLocalGitRunner));
+    for (branch, changes) in [("main", "No changes"), ("feature", "+1 -0")] {
+        if branch == "feature" {
+            git(&["checkout", "-b", "feature"]);
+            std::fs::write(repo.path().join("file"), "one line\n").expect("write change");
+            git(&["add", "file"]);
+            git(&[
+                "-c",
+                "user.name=Test",
+                "-c",
+                "user.email=test@example.com",
+                "commit",
+                "-m",
+                "change",
+            ]);
+        }
+        handle_turn_completed(&mut chat, "turn-1", /*duration_ms*/ None);
+        assert!(chat.status_line_branch_pending && chat.status_line_git_summary_pending);
+        tokio::time::timeout(Duration::from_secs(/*secs*/ 10), async {
+            while chat.status_line_branch_pending || chat.status_line_git_summary_pending {
+                match rx.recv().await.expect("completion event") {
+                    AppEvent::StatusLineBranchUpdated { cwd, branch } => {
+                        chat.set_status_line_branch(cwd, branch)
+                    }
+                    AppEvent::StatusLineGitSummaryUpdated { cwd, summary } => {
+                        chat.set_status_line_git_summary(cwd, summary)
+                    }
+                    _ => {}
+                }
+            }
+        })
+        .await
+        .expect("Git refresh completes");
+        assert_eq!(chat.status_line_branch.as_deref(), Some(branch));
+        assert_eq!(
+            chat.status_line_value_for_item(crate::bottom_pane::StatusLineItem::BranchChanges),
+            Some(changes.into())
+        );
+    }
+}
