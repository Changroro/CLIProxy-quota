@@ -0,0 +1,82 @@
+package handlers
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+func TestSessionAccountBeforeResponseAndRetryIsolation(t *testing.T) {
+	const sid = "0199a000-0000-7000-8000-000000000001"
+	const other = "0199a000-0000-7000-8000-000000000002"
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	callbackCount := 0
+	meta := map[string]any{coreexecutor.SelectedAuthIndexCallbackMetadataKey: func(string) { callbackCount++ }}
+	headers := http.Header{"Thread-Id": []string{sid}, "Session-Id": []string{"cache-key"}}
+	observeSessionAccount(ctx, headers, meta)
+	callback := meta[coreexecutor.SelectedAuthIndexCallbackMetadataKey].(func(string))
+	callback("account-a")
+	read := func(id string) map[string]any {
+		rr := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(rr)
+		c.Request = httptest.NewRequest("GET", "/?session_id="+id, nil)
+		GetSessionAccount(c)
+		if rr.Code != 200 {
+			t.Fatalf("status %d", rr.Code)
+		}
+		var body map[string]any
+		if err := json.Unmarshal(rr.Body.Bytes(), &body); err != nil {
+			t.Fatal(err)
+		}
+		return body
+	}
+	account := read(sid)["account"].(map[string]any)
+	if account["auth_index"] != "account-a" || account["active"] != true {
+		t.Fatalf("selection not visible before response: %v", account)
+	}
+	if read(other)["account"] != nil {
+		t.Fatal("cross-session account leak")
+	}
+	callback("account-b")
+	if read(sid)["account"].(map[string]any)["auth_index"] != "account-b" || callbackCount != 2 {
+		t.Fatal("retry or original callback lost")
+	}
+	invalid := map[string]any{}
+	observeSessionAccount(ctx, http.Header{"Thread-Id": []string{"bad"}}, invalid)
+	if len(invalid) != 0 {
+		t.Fatal("invalid session observed")
+	}
+}
+
+func TestSessionAccountWebsocketDoesNotWriteUpgradeHeaders(t *testing.T) {
+	const sid = "0199a000-0000-7000-8000-000000000005"
+	rr := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rr)
+	c.Request = httptest.NewRequest("GET", "/v1/responses", nil)
+	c.Request.Header.Set("Connection", "Upgrade")
+	c.Request.Header.Set("Upgrade", "websocket")
+	c.Request.Header.Set("Thread-Id", sid)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	meta := requestExecutionMetadata(context.WithValue(ctx, "gin", c))
+	callback, ok := meta[coreexecutor.SelectedAuthIndexCallbackMetadataKey].(func(string))
+	if !ok {
+		t.Fatal("websocket selection observer missing")
+	}
+	callback("synthetic-ws-account")
+	if len(rr.Header()) != 0 {
+		t.Fatal("observer wrote websocket response headers")
+	}
+	sessionAccounts.Lock()
+	entry := sessionAccounts.entries[sid]
+	sessionAccounts.Unlock()
+	if entry.AuthIndex != "synthetic-ws-account" || !entry.Active {
+		t.Fatal("websocket account not visible")
+	}
+}
