diff --git a/sdk/api/handlers/session_account.go b/sdk/api/handlers/session_account.go
new file mode 100644
index 00000000..259087ad
--- /dev/null
+++ b/sdk/api/handlers/session_account.go
@@ -0,0 +1,95 @@
+package handlers
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/google/uuid"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type sessionAccount struct {
+	AuthIndex  string `json:"auth_index"`
+	Active     bool   `json:"active"`
+	SelectedAt int64  `json:"selected_at"`
+	version    uint64
+}
+
+var sessionAccounts = struct {
+	sync.Mutex
+	entries map[string]sessionAccount
+	version uint64
+}{entries: make(map[string]sessionAccount)}
+
+func observeSessionAccount(ctx context.Context, headers http.Header, meta map[string]any) {
+	// Thread-Id is the harness identity; Session-Id may instead be a cache-affinity key.
+	sessionID := headers.Get("Thread-Id")
+	if sessionID == "" {
+		sessionID = headers.Get("X-Claude-Code-Session-Id")
+	}
+	id, err := uuid.Parse(sessionID)
+	if err != nil {
+		return
+	}
+	sessionID = id.String()
+	previous, _ := meta[coreexecutor.SelectedAuthIndexCallbackMetadataKey].(func(string))
+	meta[coreexecutor.SelectedAuthIndexCallbackMetadataKey] = func(index string) {
+		if previous != nil {
+			previous(index)
+		}
+		if index == "" {
+			return
+		}
+		now := time.Now().Unix()
+		sessionAccounts.Lock()
+		for key, entry := range sessionAccounts.entries {
+			if now-entry.SelectedAt > 21600 {
+				delete(sessionAccounts.entries, key)
+			}
+		}
+		// ponytail: bounded local observer; a shared store is needed for multi-node routing.
+		if len(sessionAccounts.entries) >= 4096 {
+			var oldest string
+			var oldestTime int64 = 1<<63 - 1
+			for key, entry := range sessionAccounts.entries {
+				if entry.SelectedAt < oldestTime {
+					oldest, oldestTime = key, entry.SelectedAt
+				}
+			}
+			delete(sessionAccounts.entries, oldest)
+		}
+		sessionAccounts.version++
+		version := sessionAccounts.version
+		sessionAccounts.entries[sessionID] = sessionAccount{AuthIndex: index, Active: true, SelectedAt: now, version: version}
+		sessionAccounts.Unlock()
+		context.AfterFunc(ctx, func() {
+			sessionAccounts.Lock()
+			defer sessionAccounts.Unlock()
+			entry := sessionAccounts.entries[sessionID]
+			if entry.version == version {
+				entry.Active = false
+				sessionAccounts.entries[sessionID] = entry
+			}
+		})
+	}
+}
+
+// GetSessionAccount exposes only a stable account index behind management authentication.
+func GetSessionAccount(c *gin.Context) {
+	id, err := uuid.Parse(c.Query("session_id"))
+	if err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid session ID"})
+		return
+	}
+	sessionAccounts.Lock()
+	entry, exists := sessionAccounts.entries[id.String()]
+	sessionAccounts.Unlock()
+	if !exists || time.Now().Unix()-entry.SelectedAt > 21600 {
+		c.JSON(http.StatusOK, gin.H{"account": nil})
+		return
+	}
+	c.JSON(http.StatusOK, gin.H{"account": entry})
+}
